rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function ownsLoan(loanId) {
      return signedIn()
        && get(/databases/$(database)/documents/loans/$(loanId)).data.userId == request.auth.uid;
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());

      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.role == 'user'
        && request.resource.data.kycStatus == 'pending';

      allow update: if isAdmin()
        || (signedIn()
          && request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'fullName',
            'phoneNumber',
            'nrcNumber',
            'photoURL',
            'updatedAt'
          ]));

      allow delete: if false;
    }

    match /loans/{loanId} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());

      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.amount > 0
        && request.resource.data.totalPaid == 0
        && request.resource.data.keys().hasOnly([
          'userId',
          'applicationNumber',
          'fullName',
          'dateOfBirth',
          'nrcNumber',
          'mobileMoney',
          'amount',
          'requestedTermMonths',
          'termMonths',
          'purpose',
          'status',
          'totalPaid',
          'temporaryPolicy',
          'documentsUploaded',
          'documentNames',
          'createdAt',
          'createdAtISO'
        ]);

      allow update: if isAdmin();
      allow delete: if false;

      match /payments/{paymentId} {
        allow read: if isAdmin() || ownsLoan(loanId);
        allow create, update: if isAdmin();
        allow delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
